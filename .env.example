# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=False
ALLOWED_HOSTS=your-domain.com
NGINX_BIND_ADDRESS=127.0.0.1
TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Use a URL-safe generated password because Compose also embeds it in DATABASE_URL.
POSTGRES_DB=garment_production
POSTGRES_USER=garment_user
POSTGRES_PASSWORD=replace-with-a-generated-url-safe-password